# Copy to backend.hcl (gitignored) and fill in the values from the bootstrap
# outputs:
#   cp backend.hcl.example backend.hcl
#   terraform init -backend-config=backend.hcl
bucket = "REPLACE-ME-same-name-as-bootstrap-state_bucket_name"

# One state file per environment. Keep the key unique per env/stack.
key = "envs/dev/terraform.tfstate"

region = "ap-south-1"
